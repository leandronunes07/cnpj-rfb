# ==================================================================
# CNPJ Receita Federal ETL Engine & Microservice API (Go)
# Configuração de Ambiente para Easypanel / Local
# ==================================================================

# Driver do Banco de Dados: "postgres", "mysql", "sqlite", "turso", "duckdb", ou "clickhouse"
DB_DRIVER=postgres

# Conexão para Postgres, MySQL e ClickHouse
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=cnpj
DB_SSLMODE=disable

# Arquivo para SQLite / Turso / DuckDB
DB_FILE=./data/cnpj.sqlite

# Servidor HTTP API REST & Dashboard Web (Altere a porta se a 8080 já estiver em uso no servidor)
API_PORT=8080
# Obrigatório: gere um token forte e secreto, ex.: openssl rand -hex 32
API_TOKEN=

# Diretórios de trabalho temporários
OUTPUT_FILES_PATH=./data/zip
EXTRACTED_FILES_PATH=./data/extracted

# URL Base da Receita Federal
DATA_BASE_URL=https://arquivos.receitafederal.gov.br/index.php/s/YggdBLfdninEJX9

# Competência Específica (Opcional, ex: 2026-07). Se vazio, descobre a mais recente automaticamente.
DATA_MONTH=

# Quantidade de workers paralelos para download
DOWNLOAD_WORKERS=4

# Tamanho do lote para inserção no banco (registros por transaction).
# O valor efetivo é min(BATCH_SIZE, limite_de_placeholders / nº de colunas da tabela),
# então para tabelas largas (ex.: estabelecimento, ~30 colunas) o teto real fica
# bem abaixo deste número mesmo se ele for aumentado.
BATCH_SIZE=10000

# Deletar arquivos .zip e .csv automaticamente após inserção no banco
AUTO_CLEANUP=true

# Expressão Cron para execução diária (Padrão: todos os dias às 03:00)
CRON_SCHEDULE=0 3 * * *

# Se true, executa uma vez e encerra (ideal para chamadas via CRON externo ou CLI)
RUN_ONCE=false

# ==================================================================
# Redis (opcional) — vazio = desativado, a aplicação funciona normalmente
# sem ele (lock de execução do pipeline fica local, sem rate limiting na API).
# Só se justifica se você rodar múltiplas instâncias do app (lock precisa ser
# compartilhado) e/ou quiser limitar requisições por cliente na API.
# ==================================================================
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
# Requisições por minuto, por cliente (IP), quando REDIS_ADDR está configurado
RATE_LIMIT_PER_MINUTE=120

# ==================================================================
# Meilisearch (opcional) — vazio = desativado, GET /api/v1/busca continua
# funcionando via SQL (LIKE/pg_trgm/FULLTEXT conforme o driver, ver docs/API.md).
# Configure para ganhar ranking de relevância e tolerância a erro de digitação
# na busca por nome.
# ==================================================================
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=estabelecimentos
